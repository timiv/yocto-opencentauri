boot_partition=bootA
root_partition=rootfsA
dsp0_partition=dsp0A
systemAB_next=A
boot_part=4
mmc_root=/dev/mmcblk0p5
swu_version=0.0.0
setargs_mmc=setenv bootargs console=ttyS0,115200 earlycon=uart8250,mmio32,0x02500000 root=${mmc_root} rootwait
boot_kernel=mmc dev 0; fatload mmc 0:${boot_part} 0x43000000 zImage; fatload mmc 0:${boot_part} 0x43800000 elegoo-centauri-carbon1.dtb; fatload mmc 0:${boot_part} 0x46000000 initramfs.cpio.gz; bootz 0x43000000 0x46000000:${filesize} 0x43800000
